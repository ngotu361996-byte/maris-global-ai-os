# Copy to .env for local development. Never commit real secrets.
# App connects as the non-superuser role so Row-Level Security applies.
DATABASE_URL=postgres://maris_app:maris_app_dev@localhost:5432/maris
# Owner role, used only by migrations.
DATABASE_ADMIN_URL=postgres://maris:maris_dev@localhost:5432/maris
# 32 bytes, base64. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
MFA_ENCRYPTION_KEY=
# 32 bytes, base64, different from the MFA key. Encrypts Secret Vault values. Losing it loses every stored secret.
VAULT_MASTER_KEY=
REDIS_URL=redis://localhost:6379
API_PORT=4000
WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
